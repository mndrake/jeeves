<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime audio input. Not sandboxed in v1 (docs/prd/08): process taps
	     and indexing arbitrary folders are simpler outside the App Sandbox. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
